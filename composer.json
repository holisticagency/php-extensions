{
    "name": "holistic-agency/php-extensions",
    "description": "PHP Extensions Manager",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "JamesRezo",
            "email": "james@rezo.net"
        }
    ],
    "require": {
        "php": ">=8.1",
        "psr/container": "^2.0",
        "psr/simple-cache": "^3.0",
        "symfony/process": "^7.3",
        "symfony/var-dumper": "^7.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.3"
    },
    "autoload": {
        "psr-4": {
            "HolisticAgency\\PhpExtensions\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "HolisticAgency\\Test\\PhpExtensions\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    }
}
